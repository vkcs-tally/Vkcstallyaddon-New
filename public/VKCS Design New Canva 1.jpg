<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 1067" width="100%" height="100%">
  <defs>
    <linearGradient id="bgGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284c7" />
      <stop offset="40%" stop-color="#0369a1" />
      <stop offset="100%" stop-color="#075985" />
    </linearGradient>
    <filter id="shadow1" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#000000" flood-opacity="0.3" />
    </filter>
  </defs>

  <!-- Background -->
  <rect width="600" height="1067" fill="url(#bgGrad1)" />

  <!-- Abstract Tech Grid Lines & Rays -->
  <path d="M 0,200 L 600,300 M 0,500 L 600,450 M 0,700 L 600,800" stroke="#38bdf8" stroke-width="1" opacity="0.25" />
  <circle cx="50" cy="550" r="180" fill="#38bdf8" opacity="0.08" />
  <circle cx="550" cy="350" r="140" fill="#38bdf8" opacity="0.08" />

  <!-- Top Ribbon Banner: LAUNCHING AT TALLYSHOP -->
  <g transform="translate(300, 75)">
    <text text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="34" font-weight="900" letter-spacing="2">
      LAUNCHING AT TALLYSHOP
    </text>
  </g>

  <!-- Big Yellow Headline: FREE ADD-ON MULTIPLE BANK DETAILS WITH UPI ON MODERN INVOICE 7.1 -->
  <g transform="translate(300, 150)">
    <text text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="38" font-weight="900" letter-spacing="1">
      FREE ADD-ON
    </text>
    <text y="50" text-anchor="middle" fill="#facc15" font-family="'Inter', sans-serif" font-size="42" font-weight="900" letter-spacing="1">
      MULTIPLE
    </text>
    <text y="105" text-anchor="middle" fill="#facc15" font-family="'Inter', sans-serif" font-size="40" font-weight="900" letter-spacing="1">
      BANK DETAILS WITH UPI
    </text>
    <text y="160" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="36" font-weight="900" letter-spacing="1">
      ON MODERN INVOICE 7.1
    </text>
  </g>

  <!-- Center Card Illustration: Modern Invoice with Multiple Bank & QR Details -->
  <g transform="translate(90, 370)" filter="url(#shadow1)">
    <!-- Invoice Sheet -->
    <rect width="420" height="340" rx="16" fill="#ffffff" stroke="#e0f2fe" stroke-width="3" />
    <path d="M 0,0 L 420,0 L 420,50 L 0,50 Z" fill="#0284c7" rx="16" />
    <text x="25" y="35" fill="#ffffff" font-family="'Inter', sans-serif" font-size="20" font-weight="800">INVOICE</text>
    <rect x="250" y="22" width="145" height="10" rx="4" fill="#bae6fd" />
    <rect x="300" y="36" width="95" height="6" rx="3" fill="#bae6fd" />

    <!-- Table header -->
    <rect x="20" y="70" width="380" height="24" rx="4" fill="#0369a1" />
    <rect x="20" y="100" width="380" height="12" rx="2" fill="#f0f9ff" />
    <rect x="20" y="118" width="380" height="12" rx="2" fill="#e0f2fe" />
    <rect x="20" y="136" width="380" height="12" rx="2" fill="#f0f9ff" />

    <!-- Feature Popout 1: Multiple Bank Details Badge -->
    <g transform="translate(10, 130)" filter="url(#shadow1)">
      <rect width="180" height="105" rx="12" fill="#ffffff" stroke="#38bdf8" stroke-width="2" />
      <text x="90" y="32" text-anchor="middle" font-size="26">🏦</text>
      <text x="90" y="55" text-anchor="middle" fill="#0369a1" font-family="'Inter', sans-serif" font-size="12" font-weight="bold">Bank A &amp; Bank B</text>
      <rect x="15" y="68" width="150" height="25" rx="6" fill="#f0f9ff" />
      <text x="90" y="85" text-anchor="middle" fill="#0284c7" font-family="'Inter', sans-serif" font-size="11" font-weight="bold">Multiple Bank Details</text>
    </g>

    <!-- Feature Popout 2: Dynamic UPI QR Code Badge -->
    <g transform="translate(210, 190)" filter="url(#shadow1)">
      <rect width="190" height="85" rx="12" fill="#ffffff" stroke="#22c55e" stroke-width="2" />
      <!-- Simulated QR code -->
      <rect x="15" y="15" width="55" height="55" rx="6" fill="#0f172a" />
      <rect x="22" y="22" width="18" height="18" fill="#ffffff" />
      <rect x="26" y="26" width="10" height="10" fill="#0f172a" />
      <rect x="46" y="22" width="16" height="16" fill="#ffffff" />
      <rect x="22" y="46" width="16" height="16" fill="#ffffff" />
      <rect x="44" y="44" width="20" height="20" fill="#ffffff" />
      <!-- Text details -->
      <text x="80" y="36" fill="#0f172a" font-family="'Inter', sans-serif" font-size="13" font-weight="bold">UPI Payment</text>
      <rect x="80" y="45" width="95" height="22" rx="11" fill="#15803d" />
      <text x="127" y="60" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="11" font-weight="bold">Scan &amp; Pay</text>
    </g>
  </g>

  <!-- 3 Feature Icon Pills -->
  <g transform="translate(0, 740)">
    <!-- 1: Multiple Banks -->
    <g transform="translate(90, 0)">
      <circle cx="45" cy="45" r="42" fill="#ffffff" filter="url(#shadow1)" />
      <text x="45" y="52" text-anchor="middle" font-size="34">🏛️</text>
      <text x="45" y="110" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="16" font-weight="bold">Multiple</text>
      <text x="45" y="130" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="16" font-weight="bold">Banks</text>
    </g>

    <!-- 2: Easy UPI -->
    <g transform="translate(255, 0)">
      <circle cx="45" cy="45" r="42" fill="#ffffff" filter="url(#shadow1)" />
      <text x="45" y="52" text-anchor="middle" font-size="34">📱</text>
      <text x="45" y="110" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="16" font-weight="bold">Easy</text>
      <text x="45" y="130" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="16" font-weight="bold">UPI</text>
    </g>

    <!-- 3: Instant Sync -->
    <g transform="translate(420, 0)">
      <circle cx="45" cy="45" r="42" fill="#ffffff" filter="url(#shadow1)" />
      <text x="45" y="52" text-anchor="middle" font-size="34">⚡</text>
      <text x="45" y="110" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="16" font-weight="bold">Instant</text>
      <text x="45" y="130" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="16" font-weight="bold">Sync</text>
    </g>
  </g>

  <!-- Bottom CTA: VISIT TALLYSHOP & VKCS EMBLEM -->
  <g transform="translate(300, 920)">
    <rect x="-160" y="-20" width="320" height="42" rx="21" fill="#facc15" filter="url(#shadow1)" />
    <text x="0" y="8" text-anchor="middle" fill="#0f172a" font-family="'Inter', sans-serif" font-size="16" font-weight="900" letter-spacing="1">
      GET IT NOW • VISIT TALLYSHOP
    </text>

    <!-- Tally & TallyShop Logos -->
    <g transform="translate(-110, 40)">
      <text x="0" y="20" fill="#ffffff" font-family="'Georgia', serif" font-size="28" font-style="italic" font-weight="bold">Tally</text>
      <line x1="80" y1="0" x2="80" y2="28" stroke="#ffffff" stroke-width="1.5" opacity="0.6" />
      <text x="100" y="20" fill="#ffffff" font-family="'Inter', sans-serif" font-size="22" font-weight="900">TallyShop</text>
    </g>
  </g>

  <!-- VKCS Seal (Bottom Left) -->
  <g transform="translate(80, 955)">
    <circle cx="0" cy="0" r="48" fill="#075985" stroke="#38bdf8" stroke-width="3" />
    <text x="0" y="-22" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="8" font-weight="bold" letter-spacing="1">DEVELOPING</text>
    <text x="0" y="5" text-anchor="middle" fill="#facc15" font-family="'Inter', sans-serif" font-size="16" font-weight="900">VKCS</text>
    <text x="0" y="25" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="7" font-weight="bold" letter-spacing="0.5">TALLY SOLUTIONS</text>
  </g>

  <!-- Bottom Helper Bar -->
  <rect x="0" y="1025" width="600" height="42" fill="#facc15" />
  <text x="300" y="1052" text-anchor="middle" fill="#0f172a" font-family="'Inter', sans-serif" font-size="15" font-weight="800">
    Open TallyPrime &gt; F1 Help &gt; Select - TallyShop
  </text>
</svg>
