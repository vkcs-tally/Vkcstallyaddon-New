<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 400" width="100%" height="100%">
  <defs>
    <!-- Clip path for circular logo -->
    <clipPath id="circleClip">
      <circle cx="200" cy="200" r="160" />
    </clipPath>
    <!-- Text Paths for circular text -->
    <path id="textPathTop" d="M 80,200 A 120,120 0 0,1 320,200" fill="none" />
    <path id="textPathBottom" d="M 325,208 A 125,125 0 0,1 75,208" fill="none" />
  </defs>

  <!-- Background -->
  <rect width="800" height="400" fill="#ffffff" rx="16" />

  <!-- Left abstract decorative curves -->
  <path d="M 0,0 L 260,0 C 400,100 320,320 0,400 Z" fill="#0c4a75" />
  <path d="M 0,260 C 180,280 240,360 210,400 L 0,400 Z" fill="#f59e0b" />
  <path d="M 280,0 C 370,120 280,300 0,390 L 0,400 C 380,390 420,100 290,0 Z" fill="#06b6d4" opacity="0.4" />

  <!-- Circular VKCS Badge -->
  <!-- Outer Ring (Teal / Cyan) -->
  <circle cx="195" cy="200" r="150" fill="none" stroke="#06b6d4" stroke-width="12" />
  <!-- Inner Ring (Dark Blue) -->
  <circle cx="195" cy="200" r="138" fill="#0f4c81" stroke="#ffffff" stroke-width="4" />
  <!-- Center Accent Ring -->
  <circle cx="195" cy="200" r="102" fill="#0d3f6d" stroke="#ffffff" stroke-width="2" stroke-dasharray="3,3" />

  <!-- Circular Text -->
  <text fill="#ffffff" font-family="'Inter', sans-serif" font-size="20" font-weight="800" letter-spacing="4">
    <textPath href="#textPathTop" startOffset="50%" text-anchor="middle">
      DEVELOPING
    </textPath>
  </text>
  <text fill="#ffffff" font-family="'Inter', sans-serif" font-size="19" font-weight="800" letter-spacing="4">
    <textPath href="#textPathBottom" startOffset="50%" text-anchor="middle">
      TALLY SOLUTIONS
    </textPath>
  </text>

  <!-- Flanking white dots -->
  <circle cx="106" cy="200" r="5" fill="#ffffff" />
  <circle cx="284" cy="200" r="5" fill="#ffffff" />

  <!-- VKCS Center Text -->
  <text x="195" y="215" fill="#facc15" font-family="'Inter', sans-serif" font-size="44" font-weight="900" text-anchor="middle" letter-spacing="2">
    VKCS
  </text>

  <!-- Right Content Container -->
  <!-- Top Right Header: Certified Partner -->
  <g transform="translate(460, 45)">
    <text x="160" y="28" text-anchor="end" fill="#0369a1" font-family="'Inter', sans-serif" font-size="14" font-weight="700">
      Certified Tally Integrator &amp; Extender
    </text>

    <!-- Tally Logo -->
    <g transform="translate(180, 0)">
      <text x="0" y="24" fill="#b91c1c" font-family="'Georgia', serif" font-size="28" font-style="italic" font-weight="bold">
        Tally
      </text>
      <text x="0" y="36" fill="#334155" font-family="'Inter', sans-serif" font-size="7" font-weight="bold" letter-spacing="1">
        POWER OF SIMPLICITY
      </text>
    </g>
  </g>

  <!-- Main Brand Title -->
  <text x="540" y="145" text-anchor="middle" fill="#eab308" font-family="'Inter', sans-serif" font-size="24" font-weight="900" letter-spacing="1.5">
    V K COMPUTERISED SYSTEM
  </text>

  <!-- Pill Badge: Developing Tally Solutions -->
  <g transform="translate(425, 162)">
    <rect width="230" height="32" rx="16" fill="#0f4c81" />
    <text x="115" y="21" text-anchor="middle" fill="#ffffff" font-family="'Inter', sans-serif" font-size="13" font-weight="700">
      Developing Tally Solutions
    </text>
  </g>

  <!-- Contact Details -->
  <!-- Phone -->
  <g transform="translate(410, 222)">
    <circle cx="295" cy="8" r="14" fill="#1e293b" />
    <!-- Phone SVG icon -->
    <path d="M 291,3 C 291,3 289,3 289,5 C 289,10 293,14 298,14 C 300,14 300,12 300,12 L 297,10 L 295,11 C 293,10 293,10 292,8 L 293,6 Z" fill="#ffffff" />
    <text x="270" y="13" text-anchor="end" fill="#0f172a" font-family="'Inter', sans-serif" font-size="15" font-weight="700">
      98250 42042, 96647 88685
    </text>
  </g>

  <!-- Email -->
  <g transform="translate(410, 258)">
    <circle cx="295" cy="8" r="14" fill="#1e293b" />
    <!-- Email SVG icon -->
    <path d="M 288,4 L 302,4 C 303,4 304,5 304,6 L 304,12 C 304,13 303,14 302,14 L 288,14 C 287,14 286,13 286,12 L 286,6 C 286,5 287,4 288,4 Z M 288,6 L 295,10 L 302,6 Z" fill="#ffffff" />
    <text x="270" y="13" text-anchor="end" fill="#0f172a" font-family="'Inter', sans-serif" font-size="15" font-weight="600">
      tally.godhra@gmail.com
    </text>
  </g>

  <!-- Address -->
  <g transform="translate(380, 294)">
    <circle cx="325" cy="8" r="14" fill="#1e293b" />
    <!-- Location Pin Icon -->
    <path d="M 325,1 C 322,1 320,3 320,6 C 320,10 325,15 325,15 C 325,15 330,10 330,6 C 330,3 328,1 325,1 Z M 325,8 C 324,8 323,7 323,6 C 323,5 324,4 325,4 C 326,4 327,5 327,6 C 327,7 326,8 325,8 Z" fill="#ffffff" />
    <text x="300" y="13" text-anchor="end" fill="#0f172a" font-family="'Inter', sans-serif" font-size="14" font-weight="600">
      Patelwada, Godhra - 389001 Gujarat India
    </text>
  </g>

  <!-- YouTube Channel Footer with Hyperlink and embedded YouTube logo -->
  <a href="https://www.youtube.com/@vkcstallyaddon" target="_blank">
    <g transform="translate(540, 350)" cursor="pointer">
      <!-- YouTube red badge -->
      <rect x="-165" y="-6" width="30" height="22" rx="6" fill="#FF0000" />
      <polygon points="-153,0 -153,10 -144,5" fill="#FFFFFF" />
      <text x="-125" y="10" text-anchor="start" fill="#d97706" font-family="'Inter', sans-serif" font-size="14" font-weight="700">
        YouTube Channel : <tspan fill="#0f172a">VKCS Tally Add-on</tspan>
      </text>
    </g>
  </a>
</svg>
